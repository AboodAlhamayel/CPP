// in Library ::

#pragma once
#include<iostream>
#include"clsDate.h";
using namespace std;

class clsInputValidate
{
public:

	static bool IsNumberBetween(int Number, int From, int To)
	{
		return (Number >= From && Number <= To);
	}

	static bool IsNumberBetween(double Number, double From, double To)
	{
		return (Number >= From && Number <= To);
	}

	static bool IsDateBetween(clsDate Date, clsDate From, clsDate To)
	{
		if (Date.IsDate1AfterDate2(From, To))
		{
			clsDate Temp = From;
			From = To;
			To = Temp;
		}

		if (Date.IsDate1BeforeDate2(Date, From) || Date.IsDate1AfterDate2(Date, To))
		{
			return false;
		}

		return true;
	}

	static int ReadIntNumber(string Message1)
	{
		int Number;
		cin >> Number;

		while (cin.fail())
		{
			cin.clear();
			cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
			cout << Message1;

			cin >> Number;
		}
		return Number;
	}

	static double ReadDblNumber(string Message1)
	{
		double Number;
		cin >> Number;

		while (cin.fail())
		{
			cin.clear();
			cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
			cout << Message1;

			cin >> Number;
		}
		return Number;
	}

	static int ReadIntNumberBetween(int Number1, int Number2, string Message)
	{
		int Number;
		cin >> Number;

		while (cin.fail() || Number < Number1 || Number > Number2)
		{
			cin.clear();
			cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
			cout << Message;

			cin >> Number;
		}
		return Number;
	}

	static double ReadDblNumberBetween(int Number1, int Number2, string Message)
	{
		int Number;
		cin >> Number;

		while (cin.fail() || Number < Number1 || Number > Number2)
		{
			cin.clear();
			cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
			cout << Message;

			cin >> Number;
		}
		return Number;
	}

	static bool IsValideDate(clsDate Date)
	{
		return (Date.IsValid());
	}
};


